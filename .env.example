# Copie para .env e preencha
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_OCR_MODEL=gpt-4.1

# Fora do Docker: sqlite:///./dockseal.db
# O Compose de desenvolvimento ignora este valor e usa PostgreSQL no serviço dockseal-db.
DATABASE_URL=sqlite:///./dockseal.db

# Não deixe vazio: o Compose envia este valor ao container e o login falha.
# Docker: docker compose run --rm --no-deps dockseal-api python -c "import secrets; print(secrets.token_urlsafe(48))"
# Fora do Docker: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Origens do front-end liberadas no CORS
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Sentry (deixe SENTRY_DSN vazio para desligar)
SENTRY_DSN=<https://79cc6921d0b1e49340259f94d8bf61cc@o4512273352818688.ingest.us.sentry.io/4512282672758784>
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=1.0
CORS_ORIGINS=["https://dockseal-front.pages.dev","http://localhost:5173"]
