# Copie para .env e preencha
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_OCR_MODEL=gpt-4.1

# Para PostgreSQL: postgresql+psycopg://user:senha@localhost:5432/dockseal (requer `uv add psycopg[binary]`)
DATABASE_URL=sqlite:///./dockseal.db

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Origens do front-end liberadas no CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
